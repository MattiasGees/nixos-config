#!/usr/bin/env sh

# Sketchybar configuration with Rosé Pine theme.

# Load color palette and icons
source "$HOME/.config/sketchybar/colorpresets/custom-theme.sh"
source "$HOME/.config/sketchybar/icons.sh"



# Directories for items and plugins
ITEM_DIR="$HOME/.config/sketchybar/items"
PLUGIN_DIR="$HOME/.config/sketchybar/plugins"

# --- Helper Process ---
# This is for the github plugin, we can leave it as is.
HELPER=git.felix.helper
killall helper 2>/dev/null
cd $HOME/.config/sketchybar/helper && make > /dev/null 2>&1
$HOME/.config/sketchybar/helper/helper $HELPER > /dev/null 2>&1 &

# --- Bar Appearance ---
sketchybar --bar \
           height=38 \
           position=top \
           sticky=off \
           margin=10 \
           color=$TRANSPARENT \
           display=main \
           notch_width=188 \
           padding_left=10 \
           padding_right=10

# --- Default Settings ---
sketchybar --default \
           icon.font="Iosevka Nerd Font:Bold:16.0" \
           icon.color=$ICON_COLOR \
           label.font="Iosevka Nerd Font:Bold:16.0" \
           label.color=$LABEL_COLOR \
           background.height=28 \
           background.corner_radius=8 \
           background.color=$ITEM_COLOR \
           padding_left=4 \
           padding_right=4 \
           label.padding_left=4 \
           label.padding_right=4 \
           icon.padding_left=4 \
           icon.padding_right=4

# --- Left Items ---
sketchybar --add item home left \
           --set home icon="" \
                      icon.color=0xff50FA7B \
                      label.drawing=off \
                      script="$ITEM_DIR/home.sh" \
           --subscribe home mouse.clicked

# Front App
sketchybar --add item front_app left \
           --set front_app script="$ITEM_DIR/front_app.sh" \
                           icon.drawing=off \
                           label.color=$WHITE \
           --subscribe front_app front_app_switched

# Days Until (tsdays)
sketchybar --add item days_until left \
           --set days_until update_freq=3600 \
                            icon=0 \
                            script="$ITEM_DIR/daysuntil.sh" \
                            icon.color=$LAVENDER \
                            label.padding_right=0

# 2. Network Speed (triggered on network changes and manual clicks)
sketchybar --add item network left 15 \
           --set network icon.color=$LAVENDER \
                         script="$ITEM_DIR/netspeed.sh" \
                         label.padding_right=4 \
                         popup.background.color=$ITEM_COLOR \
                         popup.background.corner_radius=8 \
                         popup.background.border_color=$ITEM_COLOR \
                         popup.background.border_width=1 \
           --subscribe network wifi_change mouse.clicked mouse.entered mouse.exited

# Kubernetes Context
sketchybar --add item kube left \
           --set kube update_freq=30 \
                      script="$ITEM_DIR/kube.sh" \
                      icon=󱃾 \
                      icon.color=$LAVENDER \
                      popup.background.color=$ITEM_COLOR \
                      popup.background.corner_radius=8 \
                      popup.background.border_color=$ITEM_COLOR \
                      popup.background.border_width=1 \
           --subscribe kube mouse.entered mouse.exited

# Tailscale Switcher
sketchybar --add item tailscale left \
           --set tailscale script="$ITEM_DIR/tailscale.sh" \
                           update_freq=10 \
                           icon=󰸳 \
                           icon.color=0xffA4B3B6 \
                           label.drawing=off \
                           popup.background.color=$ITEM_COLOR \
                           popup.background.corner_radius=8 \
                           popup.background.border_color=$ITEM_COLOR \
                           popup.background.border_width=1 \
           --subscribe tailscale mouse.clicked mouse.entered mouse.exited

sketchybar --add bracket left_bracket "${SPACES[@]}" home front_app days_until network kube tailscale \
           --set left_bracket background.color=$ITEM_COLOR \
                              background.corner_radius=8

# --- Right Items ---

# Clock
sketchybar --add item clock right \
           --set clock update_freq=10 \
                       script="$ITEM_DIR/clock.sh" \
                       icon=$CALENDAR \
                       icon.color=$LAVENDER \
                       padding_right=10

# Rain Chart
sketchybar --add graph rain_chart right 128 \
           --set rain_chart update_freq=120 \
                            script="$ITEM_DIR/rain.sh" \
                            icon=󰖗 \
                            icon.color=$PINK \
                            icon.padding_left=10 \
                            background.drawing=on \
                            background.border_width=0 \
                            graph.color=$LAVENDER \
                            graph.fill_color=0x80E98074 \
                            graph.line_width=2 \
                            label.drawing=off \
                            popup.background.color=$ITEM_COLOR \
                            popup.background.corner_radius=8 \
                            popup.background.border_color=$ITEM_COLOR \
                            popup.background.border_width=1 \
           --subscribe rain_chart mouse.entered mouse.exited


# IP Address and Battery
sketchybar --add item ip_address right \
           --set ip_address script="$ITEM_DIR/ip_address.sh" \
                            update_freq=10 \
                            icon=󰖩 \
                            icon.color=$PINK \
                            popup.background.color=$ITEM_COLOR \
                            popup.background.corner_radius=8 \
                            popup.background.border_color=$ITEM_COLOR \
                            popup.background.border_width=1 \
           --subscribe ip_address wifi_change mouse.entered mouse.exited \
           --add item battery right \
           --set battery script="$ITEM_DIR/battery.sh" \
                         icon.color=$LAVENDER \
                         update_freq=120 \
           --subscribe battery system_woke power_source_change

# Audio
sketchybar --add item audio right \
           --set audio script="$ITEM_DIR/audio.sh" \
                       update_freq=5 \
                       icon.color=$PINK \
                       popup.background.color=$ITEM_COLOR \
                       popup.background.corner_radius=8 \
                       popup.background.border_color=$ITEM_COLOR \
                       popup.background.border_width=1 \
           --subscribe audio volume_change mouse.clicked mouse.entered mouse.exited

# Bracket for right items
sketchybar --add bracket right_bracket rain_chart clock ip_address battery audio \
           --set right_bracket background.color=$ITEM_COLOR \
                               background.corner_radius=8

# --- Notch Gaps ---
# We add invisible gap items to push the left and right brackets away from the notch.
# The width is calculated to be half of the notch_width from the bar settings.
sketchybar --add item notch_gap left \
           --set notch_gap width=94 \
                           background.drawing=off

sketchybar --add item notch_gap_right right \
           --set notch_gap_right width=94 \
                               background.drawing=off

# --- Finalize ---
sketchybar --update

# Trigger initial network speed display
sketchybar --trigger network

echo "Sketchybar 'Rosé Pine' theme loaded."
