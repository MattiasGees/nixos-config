#! /usr/bin/env zsh
# Shell aliases - run 'halp' to fuzzy search with descriptions

# ─────────────────────────────────────────────────────────────
# Core
# ─────────────────────────────────────────────────────────────

# List with colors
alias ls='ls --color=auto'
# Long listing with details
alias ll='ls -alF'
# List including hidden files
alias la='ls -A'
# Clear terminal
alias cls="clear"
# Reload shell config
alias reload="source ~/.zshrc && echo 'Shell config reloaded from ~/.zshrc'"

