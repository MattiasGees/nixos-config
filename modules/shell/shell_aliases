# ─────────────────────────────────────────────────────────────
# Git
# ─────────────────────────────────────────────────────────────

# Fuzzy checkout git branch
alias branch='git checkout $(git branch --all | fzf)'
# Git diff
alias gd="git diff"
# Git status
alias gs="git status"
# Git log
alias gl="git log"
# Git stash
alias gst="git stash"
# Git stash pop
alias gstp="git stash pop"
# Git rebase continue
alias grc="git rebase --continue"
# Git rebase abort
alias gra="git rebase --abort"
# Git fetch
alias gf="git fetch"
# Git reset hard
alias grh="git reset --hard"
# Git push current branch
alias gp='git push origin $(git branch --show-current)'
# Git push force current branch
alias gpf='git push origin $(git branch --show-current) --force'
# Git pull origin main
alias gpm="git pull origin main"

# ─────────────────────────────────────────────────────────────
# Go
# ─────────────────────────────────────────────────────────────

# Go test all
alias gt="go test ./..."
# Go test verbose
alias gtv="go test -v ./..."
# Go test with race detector
alias gtr="go test -race ./..."
# Go mod tidy
alias gmt="go mod tidy"
# Go vet
alias gv="go vet ./..."

# ─────────────────────────────────────────────────────────────
# Utilities
# ─────────────────────────────────────────────────────────────

# Watch with alias expansion
alias watch="watch "
# Use bat instead of cat
alias cat="bat "
