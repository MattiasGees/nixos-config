{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "baseBranches": ["mattias"],
  "enabledManagers": ["custom.regex"],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Bump OCI image tags declared inline in virtualisation.oci-containers (filebrowser, pihole, dnsproxy, and any future image = \"repo:tag\";).",
      "managerFilePatterns": ["/\\.nix$/"],
      "matchStrings": ["image = \"(?<depName>[^\"]+?):(?<currentValue>[^\"]+?)\";"],
      "datasourceTemplate": "docker"
    }
  ]
}
